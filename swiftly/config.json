{
  "schemaVersion": 1,
  "theme": {
    "mode": "dark",
    "background": "#E6222632",
    "foreground": "#FFF5F7FF",
    "muted": "#FFAFB7CC",
    "accent": "#FFAEC6FF",
    "border": "#33FFFFFF"
  },
  "interaction": {
    "wrap": true,
    "scrollEnabled": true,
    "scrollInvert": false,
    "swipeEnabled": true,
    "swipeThreshold": 48,
    "animationMs": 220
  },
  "gestures": {
    "enabled": true,
    "fingers": 4,
    "nextDirection": "left",
    "previousDirection": "right",
    "targetStack": "daily"
  },
  "stacks": [
    {
      "id": "daily",
      "enabled": true,
      "monitor": "",
      "position": { "anchor": "top-right", "x": 28, "y": 80 },
      "size": { "width": 340, "height": 200 },
      "cornerRadius": 28,
      "initialIndex": 0,
      "widgets": [
        { "id": "clock", "type": "clock", "options": { "format": "HH:mm" } },
        { "id": "calendar", "type": "calendar", "options": { "firstDayOfWeek": 1 } },
        { "id": "media", "type": "media", "options": {} }
      ]
    }
  ]
}
