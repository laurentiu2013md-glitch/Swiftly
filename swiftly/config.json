{
  "schemaVersion": 1,
  "theme": {
    "mode": "dark",
    "background": "#00000000",
    "foreground": "#FFE6E0E9",
    "muted": "#FFCAC4D0",
    "accent": "#FFD0BCFF",
    "border": "#00000000"
  },
  "interaction": {
    "wrap": true,
    "clickEdgeStart": 0.9,
    "scrollEnabled": true,
    "scrollInvert": false,
    "swipeEnabled": true,
    "swipeThreshold": 48,
    "animationMs": 220,
    "animationPreset": "fade"
  },
  "gestures": {
    "enabled": true,
    "fingers": 4,
    "nextDirection": "left",
    "previousDirection": "right",
    "targetStack": "daily"
  },
  "stacks": [
    {
      "id": "daily",
      "enabled": true,
      "monitor": "",
      "position": { "anchor": "top-right", "x": 28, "y": 80 },
      "size": { "width": 340, "height": 144 },
      "cornerRadius": 28,
      "initialIndex": 0,
      "widgets": [
        { "id": "clock", "type": "clock", "options": { "format": "HH:mm" } },
        { "id": "calendar", "type": "calendar", "options": { "firstDayOfWeek": 1 } },
        { "id": "media", "type": "media", "options": {} }
      ]
    }
  ]
}
